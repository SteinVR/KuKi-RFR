{
  "data_config": "research/configs/data.json",
  "encoder_config": "research/configs/encoder.json",
  "seed": 42,
  "deterministic": true,
  "initial_state": "pinned_pretrained_base_fresh_lora_and_heads_no_ST1_weights",
  "window_length": 1024,
  "overlap": 128,
  "gradient_checkpointing": false,
  "span_dimension": 64,
  "head_dropout": 0.1,
  "proposal_top_k": 128,
  "training_candidates": "predicted_top_k_boundaries_augmented_with_train_gold_boundaries_cartesian_start_lt_end",
  "inference_candidates": "predicted_top_k_boundaries_only_cartesian_start_lt_end_no_length_cap",
  "negative_sampling": "all_unmarked_decisions_in_selected_candidate_set",
  "negative_weight": 1.0,
  "boundary_loss_weight": 0.5,
  "loss": "per_answer_balanced_positive_negative_BCE_then_mean_annotators_then_articles",
  "max_predictions": 100,
  "threshold_grid": [
    0.3,
    0.5,
    0.7,
    0.9
  ],
  "selection": "highest_dev_article_annotator_mean_exact_typed_F1_then_overlap_F1_then_higher_threshold_then_earlier_epoch",
  "gradient_accumulation_articles": 8,
  "adapter_lr": 0.0002,
  "head_lr": 0.001,
  "weight_decay": 0.01,
  "gradient_clip_norm": 1.0,
  "max_epochs": 12,
  "max_updates": 228,
  "warmup_updates": 23,
  "early_stopping_patience_epochs": 4,
  "early_stopping_min_delta": 0.0001,
  "stage_budget_minutes": 60,
  "session_save_stop_minutes": 50,
  "test_access": "disabled",
  "empty_empty_f1": 0,
  "overlap_match": "one_to_one_same_family_IoU_at_least_0.5_max_cardinality_then_IoU",
  "pair_negative_policy": "hard_top_max64_8P",
  "hard_negative_ratio": 8,
  "hard_negative_minimum": 64,
  "variant_reason": "all-negative mean diluted high-confidence false predictions; thresholds and near-duplicate suppression did not improve exact F1"
}
